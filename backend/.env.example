# Local model served by Ollama (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3
RAG_EMBED_MODEL=nomic-embed-text

# Project folder access is read-only. Add folders as a JSON object whose keys
# are names shown in the project selector. If omitted, the repository itself
# is available under the default "AI-chatbot-localmodel" project name.
# PROJECTS={"work-project":"/absolute/path/to/work-project"}
# DEFAULT_PROJECT=work-project

DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>

JWT_SECRET=<long-random-string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY=3600
